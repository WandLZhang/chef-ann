{
  "firestore": {
    "rules": "firestore.rules"
  },
  "extensions": {
    "firestore-bigquery-export": "firebase/firestore-bigquery-export@0.3.0"
  },
  "hosting": {
    "site": "chef-ann-commodity-planner",
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
